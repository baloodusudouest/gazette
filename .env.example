# Variables à saisir dans Portainer (stack homelab.yml → Environment variables).
# Ce fichier ne contient que des exemples : aucune vraie valeur dans le dépôt.

# Mot de passe commun à toutes les applis (12 caractères au moins) : sans lui, Gazette ne démarre pas
MAISON_PASSWORD=change-moi-12-caracteres-minimum
# Jeton commun des échanges entre applis maison (lecture de carnet, annuaire et sauvegardes de l'Anneau) ;
# vide : carnet pas lu, adresse de Gazette inconnue (liens relatifs), sauvegarde fermée
# MAISON_JETON=un-long-jeton-commun
# Clé de lecture de l'Anneau (contrat 3) : n'ouvre que les fiches « Connexion ». Vide : l'Anneau ne les lit pas.
# ANNEAU_CLE=une-autre-longue-cle
# « oui » : aucune appli n'écrit chez un service extérieur (GAZETTE_LECTURE_SEULE l'emporte si posée)
# MAISON_LECTURE_SEULE=oui

# Dossier du NAS pour la base de Gazette
GAZETTE_DATA_DIR=/volume1/docker/gazette

# Jeton partagé avec Home Assistant (secret gazette_jeton_ha = « Bearer <ce jeton> »)
GAZETTE_JETON_HA=change-moi-un-long-jeton-aleatoire

# « oui » ou « non » : force Gazette seule ; vide : suit MAISON_LECTURE_SEULE
GAZETTE_LECTURE_SEULE=

# Adresse de carnet (≥ 2.25) vue depuis le conteneur ; lu avec MAISON_JETON
# GAZETTE_CARNET_URL=http://carnet:8096

# 0.9 : clé d'API Immich dédiée « gazette » (permissions asset.read, asset.view, tag.read ; 0.12 : album.read, person.read), pour La Récidive ;
# vide : la Gazette sert à chaque séjour
# GAZETTE_IMMICH_CLE=une-cle-immich
# GAZETTE_IMMICH_URL=http://immich_server:2283
# 0.9.1 : Ollama du PC pour proposer des titres (vide : on écrit les titres soi-même)
# GAZETTE_OLLAMA_URL=http://adresse-du-pc:11434
# 0.9.6 : facultative, autre modèle installé sur le PC (défaut qwen2.5:7b)
# GAZETTE_OLLAMA_MODELE=qwen2.5:7b
# 0.23 : Sillage vu depuis le conteneur (étapes proposées dans la fiche complète) ; facultative, défaut ci-dessous
# GAZETTE_SILLAGE_URL=http://sillage:8093
# 0.28 : Douze points vu depuis le conteneur (édition spéciale Eurovision « Good Evening Europe! ») ; facultative, défaut ci-dessous
# GAZETTE_DOUZE_POINTS_URL=http://douze-points:8088

# Facultatif
# PORT_GAZETTE=8089
# GAZETTE_VERSION=0.8.0

# Le titre du journal, le lieu, les hôtes, le mot par défaut, la couleur et Larousse se règlent dans l'appli
# (Réglages › Le journal) et sont sauvegardés chaque nuit par l'Anneau. GAZETTE_TITRE, GAZETTE_SIGNATURE,
# GAZETTE_LIEU et GAZETTE_LAROUSSE, s'ils sont encore posés, ne servent qu'une fois (premier démarrage de la 0.8).

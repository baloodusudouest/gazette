# Variables à saisir dans Portainer (stack homelab.yml → Environment variables).
# Ce fichier ne contient que des exemples : aucune vraie valeur dans le dépôt.

# Mot de passe commun à toutes les applis (12 caractères au moins)
MAISON_PASSWORD=change-moi-12-caracteres-minimum
# Jeton commun des échanges entre applis maison (lecture de carnet, annuaire de l'Anneau)
# MAISON_JETON=un-long-jeton-commun
# « oui » : aucune appli n'écrit chez un service extérieur (GAZETTE_LECTURE_SEULE l'emporte si posée)
# MAISON_LECTURE_SEULE=oui
# Ancien nom, lu en repli tant que MAISON_PASSWORD est vide
# APPS_PASSWORD=change-moi-12-caracteres-minimum

# Dossier du NAS pour la base de Gazette
GAZETTE_DATA_DIR=/volume1/docker/gazette

# Jeton partagé avec Home Assistant (secret gazette_jeton_ha = « Bearer <ce jeton> »)
GAZETTE_JETON_HA=change-moi-un-long-jeton-aleatoire

# Le titre du journal, le lieu, les hôtes, le mot par défaut, la couleur et Larousse se règlent dans l'appli
# (Réglages › Le journal). GAZETTE_TITRE, GAZETTE_SIGNATURE, GAZETTE_LIEU, GAZETTE_LAROUSSE, s'ils existent,
# ne donnent que la valeur de départ.

# Adresse de Gazette vue du navigateur (liens des notifications HA) : repli si l'Anneau ne connaît pas
# la tuile « Gazette ». Schéma, hôte et port seulement (un chemin éventuel est retiré).
GAZETTE_ADRESSE=http://adresse-du-nas:8089

# Facultatif
# PORT_GAZETTE=8089
# GAZETTE_VERSION=0.1.0
# « oui » ou « non » : force Gazette seule ; vide : suit MAISON_LECTURE_SEULE
GAZETTE_LECTURE_SEULE=

# Carnet (≥ 2.20) : dates de naissance des invités. Même valeur que CARNET_JETON_GAZETTE dans carnet ;
# vide : MAISON_JETON est envoyé (carnet ≥ 2.25 l'accepte) ; les deux vides : carnet pas lu.
GAZETTE_CARNET_JETON=
# GAZETTE_CARNET_URL=http://carnet:8096
